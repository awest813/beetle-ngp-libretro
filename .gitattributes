# Auto-detect text files and normalize line endings
*                 text=auto

# Source code (LF for cross-platform KallistiOS build)
*.c               text eol=lf
*.cpp             text eol=lf
*.h               text eol=lf
*.s               text eol=lf
*.S               text eol=lf

# Build system
Makefile          text eol=lf
Makefile.*        text eol=lf
*.mk              text eol=lf

# Shell scripts
*.sh              text eol=lf

# Documentation
*.md              text eol=lf

# Config files
*.cfg             text eol=lf
*.json            text eol=lf
*.yml             text eol=lf
.editorconfig     text eol=lf

# Binary files
*.elf             binary
*.a               binary
*.o               binary
*.cdi             binary
*.iso             binary
*.bin             binary
*.png             binary
*.jpg             binary
*.ico             binary
